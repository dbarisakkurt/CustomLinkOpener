{
  "name": "customlinkopener",
  "displayName": "Custom Link Opener",
  "description": "Open selected text in a configurable URL from the editor context menu.",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/dbarisakkurt/CustomLinkOpener.git"
  },
  "bugs": {
    "url": "https://github.com/dbarisakkurt/CustomLinkOpener/issues"
  },
  "homepage": "https://github.com/dbarisakkurt/CustomLinkOpener#readme",
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "customlinkopener.openInJira",
        "title": "Open Custom Link"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "customlinkopener.openInJira",
          "when": "editorHasSelection && customlinkopener.hasMatchingSelection",
          "group": "navigation@101"
        }
      ]
    },
    "configuration": {
      "title": "Custom Link Opener",
      "properties": {
        "customlinkopener.items": {
          "type": "array",
          "title": "Customize Links",
          "markdownDescription": "Define one or more links to open from selected text. Use the Add Item button to create more entries.",
          "default": [
            {
              "url": "https://jira.mycompany.com/issues/{selection}",
              "sampleSelection": "ABC-<number>"
            }
          ],
          "items": {
            "type": "object",
            "default": {
              "url": "https://jira.mycompany.com/issues/{selection}",
              "sampleSelection": "ABC-<number>"
            },
            "properties": {
              "url": {
                "type": "string",
                "title": "URL",
                "default": "https://jira.mycompany.com/issues/{selection}",
                "description": "URL template for this item. Use {selection} where the chosen text should be inserted."
              },
              "sampleSelection": {
                "type": "string",
                "title": "Sample Selection",
                "default": "ABC-<number>",
                "description": "Sample selected text used for previewing the generated URL. Use <number> to match one or more digits, for example ABC-<number> or FGH-<number>-AR."
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.137.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
